[
 {
  "id": "B1",
  "exp": "block",
  "cmd": "cat {visible}/.env",
  "stderr_has": ["with-env.sh", "gate.sh"],
  "note": "env-file shape .env; the message names the runner and the gate"
 },
 {
  "id": "B2",
  "exp": "block",
  "cmd": "grep -n DUMMY_KEY svc/.env.dev",
  "note": "env-file shape .env.<suffix>"
 },
 {
  "id": "B3",
  "exp": "block",
  "cmd": "head -3 {shapes}/.envrc",
  "note": "env-file shape .envrc"
 },
 {
  "id": "B4",
  "exp": "block",
  "cmd": "sed -n 1p .env_x",
  "note": "env-file shape .env_<suffix>"
 },
 {
  "id": "B5",
  "exp": "block",
  "cmd": "python3 -c \"print(open('{tracked}/.envs/.django').read())\"",
  "note": "env-file shape .envs/ segment, named inside interpreter quotes"
 },
 {
  "id": "P1",
  "exp": "pass",
  "cmd": "cat .github/workflows/secret-hook.yml",
  "note": "the word secret in a file name is not an env file"
 },
 {
  "id": "P2",
  "exp": "pass",
  "cmd": "grep -n color src/styles/sidebar-tokens.css",
  "note": "the word tokens in a file name is not an env file"
 },
 {
  "id": "P3",
  "exp": "pass",
  "cmd": "head -5 /tmp/scratch/hs-token.txt",
  "note": "a scratch file named with token is not an env file"
 },
 {
  "id": "P4",
  "exp": "pass",
  "cmd": "cat .env.example",
  "note": ".env.example is out of scope"
 },
 {
  "id": "P5",
  "exp": "pass",
  "cmd": "sed -n 1,20p /app/env.sh",
  "note": "the fork file /app/env.sh is out of scope"
 },
 {
  "id": "P6",
  "exp": "pass",
  "cmd": "bash {clean}/run/with-env.sh uv run pytest tests/",
  "note": "the env runner itself passes"
 },
 {
  "id": "ART1",
  "exp": "block",
  "tool": "Artifact",
  "input": {"file_path": "/tmp/page.html", "file_paths": ["/tmp/a.png", "{nogit}/missing/.envs/.django/.fake"]}
 },
 {
  "id": "ART2",
  "exp": "block",
  "tool": "Artifact",
  "input": {"file_path": "/tmp/page.html", "files": {"page/data.json": {"from": "{nogit}/missing/.envs/.django/.fake"}}}
 },
 {
  "id": "ART3",
  "exp": "pass",
  "tool": "Artifact",
  "input": {"file_path": "/tmp/page.html", "file_paths": ["/tmp/a.png", "/tmp/b.png"], "files": {"a.css": "/tmp/a.css", "b.png": {"artifact": "https://claude.ai/artifact/x", "path": "b.png"}, "c.js": null}}
 },
 {
  "id": "ART4",
  "exp": "block",
  "tool": "Artifact",
  "input": {"file_path": "/tmp/page.html", "files": [{"path": "app/settings.py"}, {"path": "svc/.env.local"}]},
  "stderr_has": ["Artifact upload"],
  "note": "list form of files"
 },
 {
  "id": "X1",
  "exp": "pass",
  "raw": "{\"tool_name\": \"Bash\", \"tool_input\": {\"command\": \"cat .env\"",
  "note": "malformed JSON fails open"
 },
 {
  "id": "X2",
  "exp": "pass",
  "raw": "[{\"tool_name\": \"Bash\", \"tool_input\": {\"command\": \"cat .env\"}}]",
  "note": "a JSON list fails open"
 },
 {
  "id": "X3",
  "exp": "pass",
  "raw": "{\"tool_name\": \"Bash\", \"command\": \"cat .env\"}",
  "note": "a payload without tool_input fails open"
 }
]
