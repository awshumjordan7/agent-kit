{
  "profile": {
    "schema": 1,
    "layers": {
      "core": {"path": ".", "commit": "", "track": "main"},
      "overlay": null,
      "local": "~/.ai-setup/local"
    },
    "modules": {
      "firecrawl": true,
      "context7": true,
      "codex": false,
      "playwright": false,
      "github": false,
      "marketing": false,
      "terminal": false,
      "sandbox": false
    },
    "answers": {},
    "agents": {
      "worker": {"maxTurns": 150},
      "shipper": {"maxTurns": 50},
      "implementer": {"maxTurns": 150}
    },
    "forge": {
      "roles": {
        "review": {"provider": "codex"},
        "plan-review": {"provider": "claude"}
      },
      "stages": {"ff_review": false},
      "thresholds": {},
      "lenses": {
        "security": "(auth|permission|identity|rbac|token|session|secret|crypt|password|oauth|jwt|tenant)",
        "design": "\\.tsx$"
      },
      "ticketUrl": "",
      "repos": {"frontend": "", "backend": ""},
      "ghEnvUnset": {},
      "codex": {
        "roles": {
          "review": {"model": "gpt-6.1-sol", "effort": "xhigh", "maxToolCalls": 150, "maxToolOutputKB": 300, "toolOutputTokenLimit": 4000, "webSearch": "disabled", "mcp": false, "contract": "review"},
          "plan-review": {"model": "gpt-6.1-sol", "effort": "xhigh", "maxToolCalls": 60, "maxToolOutputKB": 200, "toolOutputTokenLimit": 4000, "webSearch": "disabled", "mcp": false, "contract": "review"}
        },
        "defaultRole": "review",
        "stallTimeoutSeconds": 300,
        "lockWaitSeconds": 1800
      },
      "gate": {},
      "workspace": ""
    },
    "ship_pr": {"base_branches": {}},
    "doctor": {
      "repo_roots": [],
      "known_repos": [],
      "metrics": {
        "since": null,
        "until": null,
        "timezone": "+00:00",
        "transcripts": "~/.claude/projects"
      },
      "codex": {
        "include_sections": ["Code Philosophy", "Validation Scope", "Plain English", "Intellectual Honesty"],
        "exclude_sections": ["Model Routing (Sub-Agents)"],
        "exclude_bullets": []
      }
    }
  },
  "recommendations": {
    "agents.scout.maxTurns": {"evidence": "126 of 314 runs reached 25 turns; p90 was 45", "confidence": "medium"},
    "agents.locator.maxTurns": {"evidence": "3 of 7 runs reached 15 turns", "confidence": "low"},
    "agents.worker.maxTurns": {"evidence": "6% of runs reached the former 90-turn cap", "confidence": "high"},
    "agents.shipper.maxTurns": {"evidence": "4 of 4 releases on 2026-09-22 reached the former 30-turn cap", "confidence": "high"},
    "agents.reviewer.maxTurns": {"evidence": "No runs reached the cap", "confidence": "high"}
  }
}
