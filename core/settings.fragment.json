{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit",
      "Write",
      "Agent",
      "Skill",
      "WebFetch",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "mcp__semgrep__*",
      "Read(**/.env.example)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envs/**)",
      "Read(**/.envrc)",
      "Read(**/.env_*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/*credential*)",
      "Read(**/.pg_service.conf)",
      "Read(**/.netrc)",
      "Read(**/.config/gh/hosts.yml)",
      "Read(**/.my.cnf)",
      "Read(**/.pgpass)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(!**/.env.example)",
      "Edit(**/.envs/**)",
      "Edit(**/.envrc)",
      "Edit(**/.env_*)",
      "Edit(**/*credential*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "attribution": false,
  "model": "claude-opus-5-5[1m]",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/user_log_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Edit|Write|NotebookEdit|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block_secret_reads.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/require_agent_model.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/lint_check.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["**/.env.example"]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {"claude-opus-5-5": {"effortLevel": "xhigh"}},
  "skipDangerousModePermissionPrompt": true,
  "enableWorkflows": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": false
}
