{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit",
      "Write",
      "Agent",
      "Skill",
      "WebFetch",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "mcp__semgrep__*",
      "Read(**/.env.example)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envs/**)",
      "Read(**/.envrc)",
      "Read(**/.env_*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/*credential*)",
      "Read(**/.pg_service.conf)",
      "Read(**/.netrc)",
      "Read(**/.my.cnf)",
      "Read(**/.pgpass)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5-5[1m]",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/doctor_daily.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Edit|Write|NotebookEdit|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block_secret_reads.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/require_agent_model.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/feedback_inbox.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/lint_check.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/context_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["**/.env.example"]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {"claude-opus-5-5": {"effortLevel": "xhigh"}},
  "skipDangerousModePermissionPrompt": true,
  "enableWorkflows": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": false
}
